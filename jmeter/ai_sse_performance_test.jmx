<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.2">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="AI API Performance Lab" enabled="true">
      <stringProp name="TestPlan.comments">JSON + SSE AI API performance test with TTFT and stream metrics</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">false</boolProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="AI API Load Test" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" enabled="true">
          <stringProp name="LoopController.loops">${__P(loops,10)}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(threads,5)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampUp,5)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <boolProp name="ThreadGroup.delayedStart">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSON POST Request" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">import java.net.HttpURLConnection
import java.net.URL
import java.net.SocketTimeoutException
import java.net.ConnectException
import java.net.UnknownHostException

def host = props.getProperty(&quot;host&quot;, &quot;127.0.0.1&quot;)
def port = props.getProperty(&quot;port&quot;, &quot;8088&quot;)
def path = props.getProperty(&quot;jsonPath&quot;, &quot;/api/chat&quot;)
def connectTimeout = Integer.parseInt(props.getProperty(&quot;connectTimeoutMs&quot;, &quot;10000&quot;))
def readTimeout = Integer.parseInt(props.getProperty(&quot;readTimeoutMs&quot;, &quot;30000&quot;))
def urlStr = &quot;http://&quot; + host + &quot;:&quot; + port + path
def payload = &apos;{&quot;message&quot;:&quot;请输出一段用于性能测试的普通 JSON 回答&quot;}&apos;

def responseCode = 0
def responseText = &quot;&quot;
def errorMsg = &quot;&quot;
def errorType = &quot;NONE&quot;

def classifyException = { Exception e -&gt;
    if (e instanceof SocketTimeoutException) {
        def m = (e.message ?: &quot;&quot;).toLowerCase()
        return m.contains(&quot;connect&quot;) ? &quot;CONNECT_TIMEOUT&quot; : &quot;READ_TIMEOUT&quot;
    }
    if (e instanceof ConnectException) return &quot;CONNECTION_REFUSED&quot;
    if (e instanceof UnknownHostException) return &quot;DNS_ERROR&quot;
    return &quot;NETWORK_ERROR&quot;
}

try {
    def conn = (HttpURLConnection)new URL(urlStr).openConnection()
    conn.setRequestMethod(&quot;POST&quot;)
    conn.setDoOutput(true)
    conn.setConnectTimeout(connectTimeout)
    conn.setReadTimeout(readTimeout)
    conn.setRequestProperty(&quot;Content-Type&quot;, &quot;application/json&quot;)
    conn.setRequestProperty(&quot;Accept&quot;, &quot;application/json&quot;)
    conn.setRequestProperty(&quot;Accept-Encoding&quot;, &quot;identity&quot;)
    conn.getOutputStream().write(payload.getBytes(&quot;UTF-8&quot;))

    responseCode = conn.getResponseCode()
    if (responseCode &gt;= 400 &amp;&amp; responseCode &lt; 500) errorType = &quot;HTTP_4XX&quot;
    else if (responseCode &gt;= 500) errorType = &quot;HTTP_5XX&quot;
    else if (responseCode &lt; 200 || responseCode &gt;= 300) errorType = &quot;HTTP_ERROR&quot;

    def input = (responseCode &gt;= 200 &amp;&amp; responseCode &lt; 300) ? conn.getInputStream() : conn.getErrorStream()
    if (input != null) {
        responseText = input.getText(&quot;UTF-8&quot;)
        input.close()
    }
    conn.disconnect()
} catch (Exception e) {
    errorMsg = e.toString()
    errorType = classifyException(e)
    responseCode = 599
}

def success = responseCode &gt;= 200 &amp;&amp; responseCode &lt; 300
SampleResult.setResponseCode(String.valueOf(responseCode))
SampleResult.setResponseData(responseText, &quot;UTF-8&quot;)
SampleResult.setResponseMessage(
    &quot;api=json,error_type=&quot; + errorType +
    (errorMsg ? &quot;,error=&quot; + errorMsg : &quot;&quot;)
)
SampleResult.setSuccessful(success)</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">false</stringProp>
        </JSR223Sampler>
        <hashTree/>

        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="SSE POST Request" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">import java.net.HttpURLConnection
import java.net.URL
import java.net.SocketTimeoutException
import java.net.ConnectException
import java.net.UnknownHostException
import java.io.BufferedReader
import java.io.InputStreamReader

def host = props.getProperty(&quot;host&quot;, &quot;127.0.0.1&quot;)
def port = props.getProperty(&quot;port&quot;, &quot;8088&quot;)
def path = props.getProperty(&quot;ssePath&quot;, &quot;/api/chat/stream&quot;)
def connectTimeout = Integer.parseInt(props.getProperty(&quot;connectTimeoutMs&quot;, &quot;10000&quot;))
def readTimeout = Integer.parseInt(props.getProperty(&quot;readTimeoutMs&quot;, &quot;30000&quot;))
def urlStr = &quot;http://&quot; + host + &quot;:&quot; + port + path
def payload = &apos;{&quot;message&quot;:&quot;请输出一段用于性能测试的流式回答&quot;}&apos;

def responseCode = 0
def responseBuilder = new StringBuilder()
def chunks = 0
def chars = 0
def done = false
def firstChunkAt = 0L
def startNs = System.nanoTime()
def errorMsg = &quot;&quot;
def errorType = &quot;NONE&quot;

def classifyException = { Exception e -&gt;
    if (e instanceof SocketTimeoutException) {
        def m = (e.message ?: &quot;&quot;).toLowerCase()
        return m.contains(&quot;connect&quot;) ? &quot;CONNECT_TIMEOUT&quot; : &quot;READ_TIMEOUT&quot;
    }
    if (e instanceof ConnectException) return &quot;CONNECTION_REFUSED&quot;
    if (e instanceof UnknownHostException) return &quot;DNS_ERROR&quot;
    return &quot;NETWORK_ERROR&quot;
}

try {
    def conn = (HttpURLConnection)new URL(urlStr).openConnection()
    conn.setRequestMethod(&quot;POST&quot;)
    conn.setDoOutput(true)
    conn.setConnectTimeout(connectTimeout)
    conn.setReadTimeout(readTimeout)
    conn.setRequestProperty(&quot;Content-Type&quot;, &quot;application/json&quot;)
    conn.setRequestProperty(&quot;Accept&quot;, &quot;text/event-stream&quot;)
    conn.setRequestProperty(&quot;Accept-Encoding&quot;, &quot;identity&quot;)
    conn.getOutputStream().write(payload.getBytes(&quot;UTF-8&quot;))

    responseCode = conn.getResponseCode()
    if (responseCode &gt;= 400 &amp;&amp; responseCode &lt; 500) errorType = &quot;HTTP_4XX&quot;
    else if (responseCode &gt;= 500) errorType = &quot;HTTP_5XX&quot;
    else if (responseCode &lt; 200 || responseCode &gt;= 300) errorType = &quot;HTTP_ERROR&quot;

    def inputStream = (responseCode &gt;= 200 &amp;&amp; responseCode &lt; 300) ? conn.getInputStream() : conn.getErrorStream()
    if (inputStream != null) {
        def reader = new BufferedReader(new InputStreamReader(inputStream, &quot;UTF-8&quot;))
        def line
        while ((line = reader.readLine()) != null) {
            responseBuilder.append(line).append(&quot;\n&quot;)
            if (line.startsWith(&quot;data: &quot;)) {
                def data = line.substring(6)
                if (data.trim() == &quot;[DONE]&quot;) {
                    done = true
                    break
                }
                chunks++
                if (firstChunkAt == 0L) firstChunkAt = System.nanoTime()
                def matcher = data =~ /&quot;delta&quot;\s*:\s*&quot;([^&quot;]*)&quot;/
                if (matcher.find()) chars += matcher.group(1).size()
            }
        }
        reader.close()
    }
    conn.disconnect()

    if (responseCode &gt;= 200 &amp;&amp; responseCode &lt; 300) {
        if (chunks == 0) {
            errorType = &quot;SSE_NO_FIRST_CHUNK&quot;
            responseCode = 598
        } else if (!done) {
            errorType = &quot;SSE_INCOMPLETE&quot;
            responseCode = 598
        }
    }
} catch (Exception e) {
    errorMsg = e.toString()
    def networkType = classifyException(e)
    errorType = chunks &gt; 0 ? &quot;SSE_INTERRUPTED&quot; : networkType
    responseCode = 599
}

def ttftMs = firstChunkAt &gt; 0L ? (firstChunkAt - startNs) / 1000000.0 : -1.0
def ttftText = String.format(java.util.Locale.US, &quot;%.2f&quot;, ttftMs)
def success = responseCode &gt;= 200 &amp;&amp; responseCode &lt; 300 &amp;&amp; done &amp;&amp; chunks &gt; 0

vars.put(&quot;sse_ttft_ms&quot;, ttftText)
vars.put(&quot;sse_chunk_count&quot;, String.valueOf(chunks))
vars.put(&quot;sse_output_chars&quot;, String.valueOf(chars))
vars.put(&quot;sse_done&quot;, String.valueOf(done))
vars.put(&quot;error_type&quot;, errorType)

SampleResult.setResponseCode(String.valueOf(responseCode))
SampleResult.setResponseData(responseBuilder.toString(), &quot;UTF-8&quot;)
SampleResult.setResponseMessage(
    &quot;api=sse,error_type=&quot; + errorType +
    &quot;,ttft_ms=&quot; + ttftText +
    &quot;,chunks=&quot; + chunks +
    &quot;,chars=&quot; + chars +
    &quot;,done=&quot; + done +
    (errorMsg ? &quot;,error=&quot; + errorMsg : &quot;&quot;)
)
SampleResult.setSuccessful(success)</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">false</stringProp>
        </JSR223Sampler>
